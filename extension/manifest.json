{
  "manifest_version": 3,
  "name": "IME Enter Guard",
  "version": "0.2.0",
  "description": "日本語入力の確定Enterで送信されてしまう問題を防ぎ、指定サイトでは ⌘/Ctrl+Enter で送信できるようにします。",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "IME Enter Guard",
    "default_popup": "popup.html"
  }
}
